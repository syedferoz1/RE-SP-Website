# Example environment variables for RE-SP-Website
# Copy to .env and fill values before deploying

# Lead capture API endpoint (serverless function or external CRM webhook)
LEADS_API_URL=https://example.com/api/leads

# API key for CRM integration
CRM_API_KEY=your_crm_api_key_here

# Google Analytics (optional)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WhatsApp number (in E.164 without +)
WHATSAPP_NUMBER=917996363343

# Vercel token for automated deployments (optional)
VERCEL_TOKEN=your_vercel_token_here
